                {
                  "name": "Polyomaviridae",
                  "type": "family",
                  "badges": [
                    "Circular",
                    "Icosahedral"
                  ],
                  "notes": "JC virus (PML in HIV), BK virus (transplant nephropathy)."
                }
              ]
            },
            {
              "name": "Single-Stranded (ssDNA)",
              "type": "genome",
              "children": [
                {
                  "name": "Parvoviridae",
                  "type": "family",
                  "badges": [
                    "Linear",
                    "Icosahedral",
                    "Smallest"
                  ],
                  "notes": "B19 virus. Erythema infectiosum (Fifth disease), aplastic crises in sickle cell, hydrops fetalis."
                }
              ]
            }
          ]
        }
      ]
    },
