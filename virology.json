                  ],
                  "notes": "HEV (Hepatitis E). Enteric, high mortality in pregnant women."
                },
                {
                  "name": "Caliciviridae",
                  "type": "family",
                  "badges": [
                    "Icosahedral"
                  ],
                  "notes": "Norovirus (viral gastroenteritis outbreaks in cruises, daycares)."
