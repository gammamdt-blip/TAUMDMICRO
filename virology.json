                  "notes": "Measles, Mumps, RSV, Parainfluenza (Croup). All contain surface F (fusion) protein."
                },
                {
                  "name": "Rhabdoviridae",
                  "type": "family",
                  "badges": [
                    "Helical",
                    "Bullet-shaped"
                  ],
                  "notes": "Rabies virus. Negri bodies in Purkinje cells/hippocampus."
                },
                {
                  "name": "Filoviridae",
                  "type": "family",
                  "badges": [
                    "Helical",
                    "Pleomorphic"
                  ],
                  "notes": "Ebola, Marburg. Hemorrhagic fever, very high mortality."
                },
                {
                  "name": "Orthomyxoviridae",
                  "type": "family",
                  "badges": [
                    "Helical",
                    "Segmented (8)",
                    "Nuclear Repl."
                  ],
                  "notes": "Influenza virus (A, B, C). Undergoes reassortment (shift) and mutation (drift)."
                },
                {
                  "name": "Bunyaviridae",
                  "type": "family",
                  "badges": [
                    "Helical",
                    "Segmented (3)"
                  ],
                  "notes": "Hantavirus (rodent urine), California encephalitis, Rift Valley fever."
                },
                {
                  "name": "Arenaviridae",
                  "type": "family",
                  "badges": [
                    "Helical",
                    "Segmented (2)",
                    "Ambisense"
                  ],
                  "notes": "LCMV, Lassa fever encephalitis. Sandy appearance on EM (host ribosomes)."
                }
              ]
            }
          ]
        },
