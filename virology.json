  "legend": [
    {
      "title": "DNA virus rules (HHAPPPy)",
      "tone": "blue",
      "items": [
        "All are **dsDNA** EXCEPT *Parvoviridae* (ssDNA).",
        "All are **Linear** EXCEPT *Papilloma, Polyoma, Hepadna* (Circular).",
        "All are **Icosahedral** EXCEPT *Poxviridae* (Complex).",
        "All replicate in the **Nucleus** EXCEPT *Poxviridae* (Cytoplasm)."
      ]
    },
    {
      "title": "RNA virus rules",
      "tone": "amber",
      "items": [
        "All are **ssRNA** EXCEPT *Reoviridae* (dsRNA).",
        "All replicate in the **Cytoplasm** EXCEPT *Orthomyxoviridae* & *Retroviridae* (Nucleus).",
        "Naked +ssRNA mnemonic: **PERCH** (Picornaviruses) & Calicivirus, Hepevirus.",
        "All -ssRNA are **Enveloped** and have **Helical** capsids."
      ]
    }
  ],
  "tree": [
    {
