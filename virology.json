                {
                  "name": "Togaviridae",
                  "type": "family",
                  "badges": [
                    "Icosahedral"
                  ],
                  "notes": "Rubella, Western/Eastern equine encephalitis (WEE/EEE)."
                },
                {
                  "name": "Retroviridae",
                  "type": "family",
                  "badges": [
                    "Icosahedral/Conical",
                    "Reverse Transcriptase",
                    "Diploid"
                  ],
                  "notes": "HIV, HTLV. Contains 2 copies of +ssRNA. Replicates in Nucleus."
                },
                {
                  "name": "Coronaviridae",
                  "type": "family",
                  "badges": [
                    "Helical Capsid",
                    "Largest RNA"
                  ],
                  "notes": "SARS-CoV, MERS-CoV, SARS-CoV-2, Common cold. Only +ssRNA with helical capsid."
                }
              ]
            }
          ]
        },
        {
          "name": "Negative-Sense ssRNA (-ssRNA)",
          "type": "genome",
          "notes": "Must bring their own RNA-dependent RNA polymerase. ALL are enveloped and have helical capsids.",
